{
  "name": "pidex",
  "private": true,
  "version": "0.2.0-beta.6",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/agent",
    "apps/auth-broker",
    "apps/desktop/*",
    "apps/website",
    "packages/*"
  ],
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "scripts": {
    "desktop:css:check": "bun run --cwd apps/desktop/renderer css:check",
    "dev": "bun run scripts/Dev.ts",
    "dev:agent": "bun run scripts/DevAgent.ts",
    "dev:renderer": "bun run --cwd apps/desktop/renderer dev",
    "dev:website": "bun run --cwd apps/website dev",
    "dev:desktop": "bun run scripts/DevDesktop.ts",
    "dev:electron": "bun run --cwd apps/desktop/electron dev",
    "debug:mcp:stdio": "bun apps/agent/scripts/McpDebugServer.ts --transport=stdio",
    "debug:mcp:http": "bun apps/agent/scripts/McpDebugServer.ts --transport=http --port=43121",
    "debug:mcp:oauth": "bun apps/agent/scripts/McpDebugServer.ts --transport=http --port=43121 --oauth",
    "debug:mcp:config:stdio": "bun apps/agent/scripts/McpDebugServer.ts --print-config=stdio",
    "debug:mcp:config:http": "bun apps/agent/scripts/McpDebugServer.ts --print-config=http",
    "debug:mcp:config:oauth": "bun apps/agent/scripts/McpDebugServer.ts --print-config=oauth",
    "test:unit": "bun test --max-concurrency 1",
    "security:audit": "bun scripts/security/SecurityAudit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --cwd packages/material-icon-theme typecheck && bun run --cwd packages/model-schema typecheck && bun run --cwd packages/shared typecheck && bun run --cwd packages/agent-protocol typecheck && bun run --cwd packages/session-view typecheck && bun run --cwd apps/auth-broker typecheck && bun run --cwd apps/agent typecheck && bun run --cwd apps/desktop/renderer typecheck && bun run --cwd apps/desktop/electron typecheck && bun run --cwd apps/website typecheck",
    "build:renderer": "bun run --cwd apps/desktop/renderer build",
    "build:website": "bun run --cwd apps/website build",
    "build:agent": "bun run --cwd apps/agent build",
    "build:cua": "bun run scripts/BuildCua.ts",
    "build:desktop": "bun run --cwd apps/desktop/electron build",
    "test:desktop:smoke": "bun run --cwd apps/desktop/electron test:smoke",
    "perf:renderer": "bun scripts/performance/RunSuite.ts --suite=renderer --enforce",
    "perf:electron": "bun scripts/performance/RunSuite.ts --suite=electron --enforce",
    "test:performance:stats": "bun test scripts/performance/Metrics.test.ts",
    "test:plan": "bun scripts/TestPlanFlow.ts",
    "test:plan:rpc": "bun scripts/TestPlanFlow.ts --rpc",
    "test:plan:live": "bun scripts/TestPlanFlow.ts --live",
    "test:review-concurrency": "bun scripts/TestReviewConcurrency.ts",
    "build": "bun run scripts/Build.ts",
    "package:win": "bun scripts/PackageWin.ts --x64",
    "version:check": "bun scripts/VersionPolicy.ts version:check",
    "version:prepare": "bun scripts/VersionPolicy.ts version:prepare",
    "lint": "oxlint --config .oxlintrc.json apps packages scripts"
  },
  "devDependencies": {
    "@pidex/shared": "workspace:*",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.11",
    "browserslist": "4.28.7",
    "extract-zip": "file:./vendor/extract-zip",
    "fast-uri": "3.1.7",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "sharp": "0.35.5",
    "tar": "7.5.21",
    "toml": "4.2.0",
    "undici": "8.10.2",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "prosemirror-view": "1.42.6"
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch"
  }
}
