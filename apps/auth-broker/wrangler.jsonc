{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codepilotx-auth-broker-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "auth-staging.codepilotx.top",
      "custom_domain": true,
    },
  ],
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23libpTIwI7SBaVpVs",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_ATTEMPTS",
        "class_name": "OAuthAttempt",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthAttempt"],
    },
  ],
  "ratelimits": [
    {
      "name": "OAUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
