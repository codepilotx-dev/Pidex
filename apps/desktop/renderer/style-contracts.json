{
  "styleEntrypoint": "src/styles/tailwind.css",
  "styleEntrypointImporter": "src/main.tsx",
  "cascadeLayerOrder": [
    "theme",
    "vendor",
    "reset",
    "tokens",
    "primitives",
    "shell",
    "features",
    "utilities",
    "overrides"
  ],
  "directStyleImportAllowlist": [
    "src/features/pet/PetOverlayPage.tsx -> src/styles/lazy/pet-overlay.css",
    "src/features/terminal/TerminalPanel.tsx -> src/styles/lazy/terminal.css"
  ],
  "lazyStyleEntrypoints": {
    "src/styles/lazy/pet-overlay.css": "features",
    "src/styles/lazy/terminal.css": "vendor"
  },
  "customPropertyReferenceAllowlist": [
    "--radix-menubar-content-transform-origin",
    "--radix-menubar-content-available-height",
    "--radix-tooltip-content-transform-origin",
    "--sidebar-collapse-target-size"
  ],
  "forbiddenCustomPropertyPatterns": [
    "^--color-bg(?:-|$)",
    "^--surface-",
    "^--border-(?:subtle|muted|control|strong)$",
    "^--color-text(?:$|-(?:strong|meta|soft|mute|muted|placeholder|disabled|on-accent)$)"
  ],
  "importantDeclarationAllowlist": {
    "src/styles/base.css": 8,
    "src/styles/popover.css": 1
  },
  "dataThemeSelectorAllowlist": {
    "src/styles/design-system/tokens.css": 4
  },
  "literalLineHeightAllowlist": {},
  "tailwindLeadingAllowlist": {},
  "featureColorContract": {
    "roots": ["src/styles/features", "src/styles/lazy"],
    "componentTokenExceptions": [
      {
        "file": "src/styles/lazy/terminal.css",
        "token": "--cpx-comp-terminal-bg",
        "reason": "终端表面配色是 xterm 第三方适配器调色板，成对声明在惰性 vendor 入口内，不能拆成系统语义色。"
      },
      {
        "file": "src/styles/lazy/terminal.css",
        "token": "--cpx-comp-terminal-fg",
        "reason": "终端表面配色是 xterm 第三方适配器调色板，成对声明在惰性 vendor 入口内，不能拆成系统语义色。"
      }
    ],
    "literalColorExceptions": [],
    "colorMixExceptions": []
  },
  "featureTokenContract": {
    "roots": ["src/styles/features", "src/styles/lazy"],
    "scriptRoots": ["src/features", "src/components"],
    "componentGeometryExceptions": [],
    "inlineStyleExceptions": [],
    "tailwindArbitraryExceptions": [
      {
        "file": "src/features/layout/workspace-header/DesktopWorkspaceHeader.tsx",
        "property": "className",
        "value": "tw:px-[var(--workspace-header-center-padding)]",
        "reason": "工作区工具栏的路由带居中内边距由左右插槽宽度在 CSS 中推导，是运行时几何值，没有静态设计令牌可替代。"
      }
    ],
    "tailwindTypographyExceptions": [],
    "literalTypographyExceptions": [],
    "literalRadiusExceptions": [],
    "literalMotionExceptions": [],
    "literalShadowExceptions": [],
    "literalZIndexExceptions": [
      {
        "file": "src/styles/features/layout-workspace-header.css",
        "property": "z-index",
        "value": "1",
        "reason": "Workspace header route groups use local grid-item ordering inside the dock layer."
      }
    ],
    "literalSpacingExceptions": []
  },
  "interactionContract": {
    "interactiveRowAllowedFiles": [
      "src/components/ui/DropdownActions.tsx",
      "src/components/ui/PopoverItem.tsx",
      "src/components/ui/SearchablePopoverContent.tsx",
      "src/features/session/summary/ThreadSummaryPanel.tsx"
    ]
  }
}
