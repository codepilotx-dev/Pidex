{
  "name": "@pidex/renderer",
  "private": true,
  "version": "0.2.0-beta.6",
  "type": "module",
  "scripts": {
    "css:check": "stylelint \"src/**/*.css\" --max-warnings 0 && bun run scripts/CheckStyleContracts.ts",
    "styles:codex:inventory": "bun run scripts/InventoryCodexStyles.ts",
    "styles:codex:check": "bun run scripts/InventoryCodexStyles.ts --check --fail-on-parse-error",
    "themes:codex:generate": "bun run scripts/GenerateThemes.ts",
    "themes:codex:check": "bun run scripts/GenerateThemes.ts --check",
    "dev": "vite --host 127.0.0.1",
    "dev:performance": "vite --mode performance --host 127.0.0.1",
    "dev:visual": "vite --mode visual --host 127.0.0.1",
    "typecheck": "tsc -b",
    "typecheck:visual:animation-contracts": "tsc -p tsconfig.visual-animation-contracts.json",
    "test": "bun test test",
    "test:a11y": "bun run scripts/RunPlaywright.ts playwright.a11y.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:visual": "bun run scripts/RunPlaywright.ts playwright.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@pidex/agent-protocol": "workspace:*",
    "@pidex/material-icon-theme": "workspace:*",
    "@pidex/session-view": "workspace:*",
    "@pidex/shared": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "1.1.1",
    "diff": "8.0.4",
    "katex": "0.17.0",
    "lucide-react": "0.468.0",
    "marked": "18.0.6",
    "mermaid": "11.16.0",
    "motion": "^12.40.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.41.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2",
    "shiki": "4.3.1",
    "virtua": "0.49.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "lightningcss": "1.32.0",
    "postcss": "^8.5.19",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
