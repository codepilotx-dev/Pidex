{
  "name": "@pidex/desktop-electron",
  "version": "0.2.0-beta.6",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit && bun build src/preload.cts --target=node --format=cjs --outfile=dist/preload.cjs --external electron && bun build src/main.ts --target=node --format=esm --outdir=dist --external electron --external node-pty --sourcemap=external && bun scripts/BuildBrowserRuntime.ts",
    "dev": "bun run build && electron .",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:plan": "playwright test --config playwright.plan.config.ts",
    "test:review-concurrency": "playwright test --config playwright.review-concurrency.config.ts",
    "package:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@pidex/shared": "workspace:*",
    "@pidex/agent-protocol": "workspace:*",
    "playwright-core": "1.59.1",
    "effect": "4.0.0-beta.83",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.0.0",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.pidex.desktop",
    "productName": "Pidex Desktop",
    "publish": {
      "provider": "github",
      "owner": "codepilotx-dev",
      "repo": "Pidex"
    },
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "../../../release",
      "buildResources": "../build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../build/pidex-mark-green.svg",
        "to": "pidex-mark-green.svg"
      },
      {
        "from": "../../agent/dist/x64/pidex-agent.exe",
        "to": "agent/pidex-agent.exe"
      },
      {
        "from": "../../agent/resources/skills",
        "to": "agent/skills"
      },
      {
        "from": "../../agent/resources/plugins",
        "to": "agent/plugins"
      },
      {
        "from": "../../agent/resources/integrations",
        "to": "agent/integrations"
      },
      {
        "from": "../native/cpx-cua/dist/cpx-cua.exe",
        "to": "cua/cpx-cua.exe"
      },
      {
        "from": "../../../dist/renderer",
        "to": "renderer"
      },
      {
        "from": "../../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../../third_party",
        "to": "third_party"
      },
      {
        "from": "../../agent/third_party/pi-agent-core/LICENSE",
        "to": "agent/third_party/pi-agent-core/LICENSE"
      }
    ],
    "protocols": [
      {
        "name": "Pidex Deep Link",
        "schemes": [
          "pidex"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "artifactName": "Pidex-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "smol-toml": "1.7.1"
  }
}
