{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@pidex/model-schema": ["../model-schema/src/index.ts"],
      "@pidex/shared": ["../shared/src/index.ts"],
      "@pidex/shared/thread": ["../shared/src/thread/index.ts"],
      "@pidex/shared/api": ["../shared/src/Api.ts"],
      "@pidex/shared/errors": ["../shared/src/Errors.ts"],
      "@pidex/shared/automation": ["../shared/src/Automation.ts"],
      "@pidex/shared/calendar": ["../shared/src/Calendar.ts"],
      "@pidex/shared/events": ["../shared/src/LlmEvent.ts"],
      "@pidex/shared/desktop-theme": ["../shared/src/DesktopTheme.ts"],
      "@pidex/shared/desktop-pet-overlay": ["../shared/src/DesktopPetOverlay.ts"],
      "@pidex/shared/desktop-data-location-ipc": ["../shared/src/DesktopDataLocationIpc.ts"],
      "@pidex/shared/desktop-deep-link-ipc": ["../shared/src/DesktopDeepLinkIpc.ts"],
      "@pidex/shared/desktop-window-ipc": ["../shared/src/DesktopWindowIpc.ts"],
      "@pidex/shared/desktop-workspace-ipc": ["../shared/src/DesktopWorkspaceIpc.ts"],
      "@pidex/shared/desktop-shell-ipc": ["../shared/src/DesktopShellIpc.ts"],
      "@pidex/shared/desktop-startup-ipc": ["../shared/src/DesktopStartupIpc.ts"],
      "@pidex/shared/desktop-appearance-ipc": ["../shared/src/DesktopAppearanceIpc.ts"],
      "@pidex/shared/desktop-attachment-ipc": ["../shared/src/DesktopAttachmentIpc.ts"],
      "@pidex/shared/desktop-browser-ipc": ["../shared/src/DesktopBrowserIpc.ts"],
      "@pidex/shared/browser-annotation": ["../shared/src/BrowserAnnotation.ts"],
      "@pidex/shared/desktop-clipboard-ipc": ["../shared/src/DesktopClipboardIpc.ts"],
      "@pidex/shared/desktop-edit-ipc": ["../shared/src/DesktopEditIpc.ts"],
      "@pidex/shared/desktop-microphone-ipc": ["../shared/src/DesktopMicrophoneIpc.ts"],
      "@pidex/shared/desktop-notification-ipc": ["../shared/src/DesktopNotificationIpc.ts"],
      "@pidex/shared/desktop-provider-icon-ipc": ["../shared/src/DesktopProviderIconIpc.ts"],
      "@pidex/shared/desktop-settings-ipc": ["../shared/src/DesktopSettingsIpc.ts"],
      "@pidex/shared/desktop-terminal-ipc": ["../shared/src/DesktopTerminalIpc.ts"],
      "@pidex/shared/desktop-update-ipc": ["../shared/src/DesktopUpdateIpc.ts"],
      "@pidex/shared/model": ["../shared/src/Model.ts"],
      "@pidex/shared/schedule-plan": ["../shared/src/SchedulePlan.ts"],
      "@pidex/shared/scheduled-task": ["../shared/src/ScheduledTask.ts"],
      "@pidex/shared/session-group": ["../shared/src/SessionGroup.ts"],
      "@pidex/shared/thread-reference": ["../shared/src/ThreadReference.ts"],
      "@pidex/shared/thread-result-card": ["../shared/src/ThreadResultCard.ts"],
      "@pidex/shared/guards": ["../shared/src/Guards.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
